DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Comma-separated admin email allowlist (lowercased). Also used to bootstrap
# the first admin user on login.
ADMIN_EMAILS="admin@example.com"

# Initial admin password. Only used when a user row for the email does not
# exist yet; the first successful login stores a hashed copy in the DB.
ADMIN_PASSWORD="change-me-please"

# Gemini API Quick Import extraction. Gemini takes priority when multiple keys are set.
# Keep API keys server-side; never prefix them with VITE_.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional OpenAI fallback when GEMINI_API_KEY is not set.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional NVIDIA NIM fallback when neither Gemini nor OpenAI is configured.
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
